# ==============================================================================
# ENROL OVERSEAS - CRM ADMIN PORTAL ENVIRONMENT VARIABLES
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=https://enrol-college-admission-course-finder-1510813378.us-west1.run.app

# NEXT_PUBLIC_SUPABASE_URL: Your Supabase Project URL (e.g., https://xxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://huhahszgueprtrosmohu.supabase.co

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: Your Supabase Anon/Public Key (starts with "sb_publishable_" or similar)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XoUVYaSTHEnacV6ep4uybw_xeoGIdpA

# SUPABASE_SERVICE_ROLE_KEY: Your Supabase secret Service Role Key.
# DO NOT expose this to the browser! This is used server-side in /api/index.ts.
# 
# How to get the Supabase Service Role Key:
# 1. Go to your Supabase Dashboard (https://supabase.com/dashboard)
# 2. Select your project (e.g., "huhahszgueprtrosmohu")
# 3. Click the "Settings" (gear icon) in the bottom left corner.
# 4. Click on "API" in the left-hand menu.
# 5. Under "Project API keys", find the key labeled "service_role" (secret).
# 6. Click "Reveal" and copy the value.
# 7. Paste it in the Settings/Secrets menu of your AI Studio applet.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Custom Admin Login Credentials for the portal
ADMIN_USERNAME=enroloverseas
ADMIN_PASSWORD=enroloverseas123
